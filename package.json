{
  "name": "agent-remote",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "syncver": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs",
    "prebuild": "npm run syncver",
    "version": "npm run syncver && git add plugins/claude/agent-remote/.claude-plugin/plugin.json plugins/codex/agent-remote/.codex-plugin/plugin.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "npm run lint && npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
