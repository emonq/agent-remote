# 飞书应用凭据: 推荐留空, 启动后打开日志里的 /setup 地址扫码一键创建并绑定
# 手动配置也支持: 飞书开放平台创建企业自建应用后填这里
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 国际版 Lark 填 lark; 国内版飞书留空或填 feishu
FEISHU_DOMAIN=lark

# ---- 单用户模式(最简): 全部可留空, 打开启动日志里的管理地址在网页上完成 ----
# 网页可生成 token; 若在这里配了则作为固定 token 使用(网页只读展示)
MCP_TOKEN=

# ---- 多用户模式: 填全套 OIDC, 则忽略上面两个 ----
# 任意标准 OIDC IdP (Keycloak/Authentik/Auth0/Logto/Zitadel...)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=xxx
OIDC_CLIENT_SECRET=xxx
OIDC_REDIRECT_URI=https://svc.example.com/auth/callback
SESSION_SECRET=随机长字符串
# DB_PATH=data/agent-remote.db (默认, docker 已挂卷)

PORT=3000
